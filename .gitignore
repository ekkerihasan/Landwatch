# ──────────────────────────────────────────────
# LandWatch — .gitignore (Python + FastAPI + Next.js)
# Covers: backend (SQLAlchemy/Alembic), frontend (Next.js/Tailwind), OS/IDE, secrets
# ──────────────────────────────────────────────

# ── Secrets / Env ──
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
frontend/.env
frontend/.env.local
frontend/.env.*.local
!.env.example
!frontend/.env.example

# ── Python / FastAPI / SQLAlchemy / Alembic ──
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
.env_venv/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.pyre/
cython_debug/

# Alembic / local DB dumps
*.db
*.sqlite
*.sqlite3
pgdata/
*.dump

# ── Node / Next.js / Tailwind (frontend/) ──
node_modules/
frontend/node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.next/cache/
frontend/.next/cache/
.vercel/
.turbo/
.parcel-cache/

# TypeScript / ESLint cache
*.tsbuildinfo
.eslintcache
.stylelintcache

# ── Logs ──
logs/
*.log
npm-debug.log*
lerna-debug.log*

# ── OS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.history/
*.code-workspace
.project
.classpath
.settings/

# ── Docker ──
.docker/

# ── Misc ──
.cache/
tmp/
temp/
*.tmp
*.temp
*.pid
*.seed
*.pid.lock
coverage/
.nyc_output/

# Raw image uploads awaiting licence review — only the named slot files ship.
frontend/public/images/image*.jpg
