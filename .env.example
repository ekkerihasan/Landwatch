# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Database -----------------------------------------------------------------
# Supabase: Connect -> Connection string -> Session pooler.
#
# Two traps, both of which fail confusingly:
#
# 1. Use the SESSION POOLER host (aws-0-<region>.pooler.supabase.com).
#    - "Direct connection" (db.<ref>.supabase.co) resolves to IPv6 only on the
#      free tier. On an IPv4-only network it fails with "connection refused",
#      which looks like a firewall problem but isn't.
#    - "Transaction pooler" (port 6543) breaks Alembic migrations. Use 5432.
#
# 2. Percent-encode reserved characters in the password.
#    SQLAlchemy URL-decodes the password, so a literal "%" must be written
#    "%25", "@" as "%40", "/" as "%2F". A password containing "%" that is not
#    escaped fails as "password authentication failed for user postgres" —
#    which looks like a wrong password rather than an encoding problem.
#
# Note the +psycopg2 driver suffix; psycopg2-binary is what requirements.txt pins.
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# For a local Postgres instead of Supabase:
# DATABASE_URL=postgresql+psycopg2://landwatch:landwatch@localhost:5432/landwatch

# --- Supabase REST API (optional) ---------------------------------------------
# Only needed if the frontend ever talks to Supabase directly via supabase-js.
# The backend does not use these — it connects over Postgres above.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>
